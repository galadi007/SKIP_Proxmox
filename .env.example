# SKIP_ENV steuert, welche Umgebung installiert wird.
# Erlaubte Werte: productive | development | test
#
# productive  -> voller Ablauf (Ansible-Bootstrap + kubeconfig + ArgoCD)
# development -> kein Ansible-Bootstrap, bestehender Server wird genutzt
# test        -> aktuell identisch zu productive (Platzhalter, weitere
#                Differenzierung noch offen)
#
# Diese Datei nach .env kopieren und anpassen:
#   cp .env.example .env
SKIP_ENV=development

# Zielserver für kubeconfig-Erstellung (make kubeconfig).
# SKIP_SSH_HOST: SSH-Alias aus ~/.ssh/config (Phase 2.3).
# SKIP_SERVER_IP: öffentliche IP, wird in die kubeconfig eingetragen.
# Defaults passen zum aktuellen FH-Server (gaming). Für die
# Ingress-Hostnamen (ArgoCD/Harbor, sslip.io-Notation) siehe zusätzlich
# apps/core/cluster-host/kustomization.yaml.
SKIP_SSH_HOST=gaming
SKIP_SERVER_IP=172.17.204.135
